# Spatial Map — settings for `docker compose up` and `npm run dev`.
# Copy this file to .env and fill in your own values. Both Docker Compose and
# Vite read .env from the repo root.

# Required. Mapbox public access token (starts with pk.).
# Create one at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token_here

# ---------------------------------------------------------------------------
# Docker Compose (docker-compose.yml) — all optional
# ---------------------------------------------------------------------------
# Port the app is served on (http://localhost:3000).
# SPATIAL_MAP_PORT=3000
# Public URL of the app, used in links inside auth emails.
# SPATIAL_MAP_PUBLIC_URL=https://maps.example.com
# First admin account, created on first start.
# SPATIAL_MAP_ADMIN_EMAIL=you@example.com
# SPATIAL_MAP_ADMIN_PASSWORD=choose-a-strong-password
# Sample facilities in a shared "Demo workspace" (first start only).
# SPATIAL_MAP_DEMO=true
# Production: set real secrets, then SPATIAL_MAP_MODE=production (the API
# refuses to start with placeholder secrets in production mode).
# SPATIAL_MAP_MODE=production
# SPATIAL_MAP_JWT_SECRET=          # openssl rand -hex 32
# SPATIAL_MAP_API_KEY=             # openssl rand -hex 32 (machine access to /api/v1)
# SPATIAL_MAP_SIGNUP_GUARD=true     # public sign-up on the internet: one account per Gmail inbox, no throwaway inboxes, 3 new accounts/network/day
# SPATIAL_MAP_DB_PASSWORD=         # only before the first start (it initialises the database)
# SPATIAL_MAP_MINIO_USER=
# SPATIAL_MAP_MINIO_PASSWORD=
# SMTP for sign-up / password-reset codes (unset: codes go to the API log).
# SPATIAL_MAP_SMTP_HOST=smtp.example.com
# SPATIAL_MAP_SMTP_PORT=587
# SPATIAL_MAP_SMTP_USER=
# SPATIAL_MAP_SMTP_PASSWORD=
# SPATIAL_MAP_MAIL_FROM=no-reply@example.com
# Image tag when using the published images (docker compose pull).
# SPATIAL_MAP_VERSION=latest

# ---------------------------------------------------------------------------
# Frontend development (npm run dev) — VITE_* values are baked into the
# browser bundle at build time, so never put server-side secrets here.
# ---------------------------------------------------------------------------

# Go backend base URL.
# In dev, leave this unset — Vite's `server.proxy` forwards same-origin
# `/api/*` and `/files/*` requests to the backend (target configurable
# via VITE_BACKEND_URL). This also lets other devices on your LAN use the
# dev server via your machine's IP.
# For a production build, set this to the absolute public URL of the
# backend (e.g. https://api.example.com), or leave it unset when the SPA
# and API are served from the same origin.
# VITE_API_BASE_URL=http://localhost:8080

# Dev-server proxy target (read by vite.config.ts only).
# Defaults to http://localhost:8080.
# VITE_BACKEND_URL=http://localhost:8080

# Local development only: the backend's dev placeholder key, sent by the
# SPA so dev tools work before you sign in. NEVER set this to your real
# SPATIAL_MAP_API_KEY in a build you serve — it ends up in the public JS
# bundle, and anyone holding that key gets machine access to every
# workspace. Signed-in users don't need it; their session authenticates them.
# VITE_API_KEY=change-me

# Optional links to your own Terms of Service / Privacy Policy, shown on
# the login and signup screens. Each link is hidden when unset.
# VITE_TERMS_URL=https://example.com/terms
# VITE_PRIVACY_URL=https://example.com/privacy
