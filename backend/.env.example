# Backend configuration
# Copy this file to .env.development or .env.production and adjust for
# your environment. The API server itself reads plain env vars — the
# `.env.<mode>` split is a shell-loading convention (make dev / make prod
# in the Makefile source the right file).

# Environment label: development | production. In production the API
# refuses to start while API_KEY / JWT_SECRET are empty or placeholders.
SGV_MODE=development

# Postgres connection URL
SGV_DATABASE.URL=postgres://spatial:spatial@localhost:5432/spatial?sslmode=disable

# API key used by admin/internal endpoints and WS subscriber gating.
# Empty = API-key check disabled (dev only). Production: `openssl rand -hex 32`.
SGV_AUTH.API_KEY=dev-api-key-change-in-production

# HS256 signing secret for user-session JWTs (signup/login). At least 32
# characters in production: `openssl rand -hex 32`.
SGV_AUTH.JWT_SECRET=dev-jwt-secret-change-in-production

# Bootstrap admin user. When both are set, the API creates this user on
# startup (if missing) and makes them owner of every existing workspace.
# Idempotent — the password is NOT rotated on later boots; use
# cmd/seed-admin for that. Leave empty to disable.
SGV_AUTH.BOOTSTRAP_EMAIL=admin@example.com
SGV_AUTH.BOOTSTRAP_PASSWORD=change-me

# Credentials for `go run ./cmd/seed-admin` (creates/updates an admin user
# and links it as owner of every workspace). Read only by that command.
SEED_EMAIL=admin@example.com
SEED_PASSWORD=change-me

# Public origin the SPA is served from. Used for links in auth emails
# (sign-in, password reset). Defaults to the Vite dev server.
SGV_APP.PUBLIC_URL=http://localhost:5173

# Mail (SMTP) for OTP verification codes. Leave HOST empty in local dev —
# the mailer will log the code to the API stdout so you can copy-paste it
# into the signup form without setting up an SMTP server first. In prod,
# point at your relay of choice (SES, Postmark, Mailgun, etc.).
SGV_MAIL.HOST=
SGV_MAIL.PORT=587
SGV_MAIL.USERNAME=
SGV_MAIL.PASSWORD=
SGV_MAIL.FROM=no-reply@spatialmap.local
SGV_MAIL.FROM_NAME=Spatial Map

# Run migrations on startup
SGV_MIGRATION.ON_START=true
SGV_MIGRATION.PATH=migrations

# Demo workspace: five sample facilities with tables, live data links and
# reports, loaded once into an empty database on first start; every new
# account joins it as an editor. Set to false BEFORE the first start for
# an install that should begin empty (or just delete the workspace later).
SGV_DEMO.ENABLED=true

# Server settings
SGV_SERVER.HOST=0.0.0.0
SGV_SERVER.PORT=8080

# Logging
LOG_LEVEL=info

# ---- Object storage ----
# Backend for uploaded images (floor plans, image planes), 3D models
# (GLBs), and profile avatars. Regardless of backend, files are served
# back through the API's /files/{key} proxy so the DB rows stay
# same-origin — the browser never talks to MinIO/S3 directly.
#
# TYPE options:
#   local           — filesystem at BASE_PATH (default). Simplest; fine
#                     for solo dev.
#   minio           — MinIO bucket only. Existing on-disk files are
#                     invisible until cmd/migrate-storage runs. Use once
#                     the cutover is done.
#   minio-fallback  — MinIO primary + local disk read fallback. THIS IS
#                     THE ZERO-DOWNTIME CUTOVER MODE. New uploads go to
#                     MinIO; legacy files on disk keep serving until
#                     migrate-storage copies them across. Every fallback
#                     read is logged so operators can see the remaining
#                     tail.
SGV_STORAGE.TYPE=local
SGV_STORAGE.BASE_PATH=./uploads
# IMPORTANT: keep this RELATIVE (no scheme + host) so uploaded image /
# model URLs are persisted as `/files/<key>`. The SPA then loads them
# same-origin and the Vite dev-server proxy forwards `/files/*` to
# this backend. With an absolute `http://localhost:8080/files` value,
# any browser opening the SPA from a different machine tries to load
# the images from its own localhost and fails.
# For production, set this to the absolute public URL of the file
# host (e.g. https://cdn.example.com/files).
SGV_STORAGE.BASE_URL=/files

# MinIO connection — required when TYPE is minio or minio-fallback.
# Defaults match the docker-compose service so `make up` "just works".
SGV_STORAGE.MINIO_ENDPOINT=localhost:9000
SGV_STORAGE.MINIO_ACCESS_KEY=minioadmin
SGV_STORAGE.MINIO_SECRET_KEY=minioadmin
SGV_STORAGE.MINIO_BUCKET=sgv-uploads
SGV_STORAGE.MINIO_REGION=us-east-1
# Set to true when MinIO / S3 is behind TLS. Local docker-compose is
# plain HTTP.
SGV_STORAGE.MINIO_USE_SSL=false

# WebSocket tuning
SGV_WEBSOCKET.WRITE_WAIT=10s
SGV_WEBSOCKET.PONG_WAIT=60s
SGV_WEBSOCKET.PING_PERIOD=54s
SGV_WEBSOCKET.MAX_MESSAGE_SIZE=65536
SGV_WEBSOCKET.REPLAY_EVENT_COUNT=100

# ---- AI floor plan detection (Python ai-worker) ----
# Powers the "AI Map" tool. The Go API is a thin dispatcher: it enqueues
# a detection task on the Python ai-worker service (Dramatiq/Redis) and
# polls until the CV pipeline (SAM 2 + Tesseract + OpenCV + Shapely)
# returns aisles / areas / doors / stairs for the user to review + accept.
#
# URL points the Go API at the ai-worker. Empty = feature disabled
# server-wide; the /floorplans/{id}/detect endpoint returns 503. The
# docker-compose default is the compose-network hostname; `make dev`
# should override to http://localhost:8100 so a raw `go run ./cmd/api`
# reaches the worker bound on the host's mapped port.
SGV_AI_WORKER.URL=http://ai-worker:8100
# Per-HTTP-call timeout to the worker (enqueue POST + each poll GET).
# The pipeline itself runs asynchronously — this is the transport-level
# ceiling, not the pipeline budget.
SGV_AI_WORKER.REQUEST_TIMEOUT=30s
# Pace of GET /detect/{taskId} polls until the task reaches a terminal
# state. Tight enough that a fast task (small image, cached model) feels
# instant; loose enough not to hammer the worker.
SGV_AI_WORKER.POLL_INTERVAL=3s
# Absolute wall-clock ceiling across all polls for a single job. Matches
# the Python Dramatiq task time_limit so we give up at the same moment
# the worker does. Bump this if you're running Phase-5+ heavy pipelines.
SGV_AI_WORKER.POLL_MAX_DURATION=300s

# Redis — Dramatiq broker for the AI worker. Only the Python side reads
# this today; the Go API keeps its state in Postgres. Kept here so
# operators have a single .env for the whole stack.
SGV_REDIS.URL=redis://redis:6379/0

# Per-tenant monthly detection cap. When COUNT(jobs) in the current
# month reaches this number, the detect endpoint returns 429. Also see
# the per-tenant opt-in flag in app_settings:
#   key   = ai_floorplan_enabled:tenant:{id}
#   value = "true" | "false"     (default "false" — feature is opt-in per tenant)
SGV_AI_WORKER.MONTHLY_CAP_PER_TENANT=200
# Per-tenant burst throttle. Fires 429 before we even touch the DB when
# a tenant spam-clicks the AI Map tool. Rate is jobs per HOUR; burst is
# how many can fire back-to-back before throttling engages. Both 0 to
# disable and rely only on the monthly cap.
SGV_AI_WORKER.HOURLY_RATE_PER_TENANT=20
SGV_AI_WORKER.HOURLY_BURST_PER_TENANT=3
