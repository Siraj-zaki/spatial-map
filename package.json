  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run models:build && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "models:build": "node scripts/build-models.mjs",
    "models:rebuild": "node scripts/build-models.mjs --force",
    "e2e:stack": "docker compose -f backend/docker-compose.yml up -d",
    "e2e:stack:stop": "docker compose -f backend/docker-compose.yml down",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --debug",
    "e2e:report": "playwright show-report"
  },
